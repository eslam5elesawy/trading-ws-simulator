{
  "name": "trading-ws-simulator",
  "version": "1.0.0",
  "description": "Simulated Saudi stock trading feed: dummy providers -> Node/Express service -> WebSocket (visible-rows batches) + Firebase Realtime DB, with a live stocks web page.",
  "scripts": {
    "test": "node --test test/*.test.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "fetch-real": "node --env-file-if-exists=.env scripts/fetch-real-stocks.js",
    "cf:dev": "npm run fetch-real && wrangler dev",
    "cf:deploy": "npm run fetch-real && wrangler deploy",
    "firebase:cleanup": "node --env-file-if-exists=.env scripts/firebase-cleanup.js"
  },
  "license": "UNLICENSED",
  "type": "module",
  "dependencies": {
    "express": "^5.3.0",
    "firebase-admin": "^14.5.1",
    "ws": "^8.23.0"
  },
  "private": true,
  "engines": {
    "node": ">=24.12"
  },
  "devDependencies": {
    "playwright-core": "^1.65.1",
    "wrangler": "^4.161.0"
  }
}
