# Copy to .env and fill in what you need. Every value is optional.

# HTTP/WebSocket port (Render sets this automatically)
PORT=8080
# Simulated ticks per second across all stocks (3000 = every stock once a second)
TICKS_PER_SECOND=3000
# Total stocks: real ones from data/real-stocks.json, then generated up to this number
STOCK_COUNT=3000
# Length of a simulated trading day in minutes; then closes roll forward and totals reset
SESSION_MINUTES=480
# Maximum WebSocket clients at once
MAX_CLIENTS=500

# Source for `npm run fetch-real` (a Firebase stocks node ending in .json). Not committed on purpose.
REAL_STOCKS_URL=

# Firebase writes are off unless both are set. Never commit the key file.
FIREBASE_DATABASE_URL=
FIREBASE_KEY_PATH=serviceAccountKey.json
# Defaults to the SIMULATOR/stocks sandbox. Any other path (e.g. REAL_TIME/stocks, which an app may read)
# also needs FIREBASE_ALLOW_ANY_PATH=true, because the simulator overwrites prices there.
FIREBASE_STOCKS_PATH=SIMULATOR/stocks
FIREBASE_ALLOW_ANY_PATH=false
